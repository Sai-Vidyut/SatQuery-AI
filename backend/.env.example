# Imagery provider: development | earth_engine
IMAGERY_PROVIDER=development

# Change detector: development | earth_engine
# Defaults to IMAGERY_PROVIDER when unset.
# CHANGE_DETECTOR=earth_engine

# SAR change detector: development | earth_engine
# Defaults to CHANGE_DETECTOR (then IMAGERY_PROVIDER) when unset.
# SAR_CHANGE_DETECTOR=earth_engine

# Semantic analyzer: development | earth_engine
SEMANTIC_ANALYZER=development

# Google Cloud project ID for Earth Engine (required when using earth_engine provider
# with service-account or cloud-project auth).
# EARTH_ENGINE_PROJECT=your-gcp-project-id

# Optional: path to service account key JSON (never commit this file).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Earth Engine authentication (choose one):
# 1. Run: earthengine authenticate
# 2. Set GOOGLE_APPLICATION_CREDENTIALS to a service account key
# 3. Use gcloud auth application-default login (for local dev)

# Upload storage (Phase 8 — user-provided imagery)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=256
# Upload bi-temporal change detection: bi_temporal (real raster CVA) | deterministic (seeded mock)
UPLOAD_CHANGE_DETECTOR=bi_temporal
# Local demo: allow PNG/JPEG uploads without benchmark_dataset=true
# UPLOAD_ALLOW_PNG_JPEG_WITHOUT_BENCHMARK=true

# GeoChat single-image VQA (Phase 10) + region interpretation (Phase 15+)
#
# LOCAL development (default — no GPU required):
GEOCHAT_VQA_PROVIDER=development
GEOCHAT_MODEL_ID=MBZUAI/geochat-7B
#
# REAL GPU service (Colab/ngrok or bare GPU host):
# 1. Start GPU service (see services/geochat/DEVELOPER.md)
# 2. Copy backend/.env.geochat-real.example → backend/.env (or merge these lines)
# 3. Run: python services/geochat/scripts/geochat_dev.py status
# GEOCHAT_VQA_PROVIDER=geochat_service
# GEOCHAT_SERVICE_URL=https://YOUR-TUNNEL-HOST
# GEOCHAT_SERVICE_TIMEOUT_S=120
# GEOCHAT_REAL_SERVICE_TEST=true
