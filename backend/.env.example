# Imagery provider: development | earth_engine
IMAGERY_PROVIDER=development

# Change detector: development | earth_engine
# Defaults to IMAGERY_PROVIDER when unset.
# CHANGE_DETECTOR=earth_engine

# SAR change detector: development | earth_engine
# Defaults to CHANGE_DETECTOR (then IMAGERY_PROVIDER) when unset.
# SAR_CHANGE_DETECTOR=earth_engine

# Semantic analyzer: development | earth_engine
SEMANTIC_ANALYZER=development

# Google Cloud project ID for Earth Engine (required when using earth_engine provider
# with service-account or cloud-project auth).
# EARTH_ENGINE_PROJECT=your-gcp-project-id

# Optional: path to service account key JSON (never commit this file).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Earth Engine authentication (choose one):
# 1. Run: earthengine authenticate
# 2. Set GOOGLE_APPLICATION_CREDENTIALS to a service account key
# 3. Use gcloud auth application-default login (for local dev)
