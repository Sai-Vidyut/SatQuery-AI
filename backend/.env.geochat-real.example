# Copy to backend/.env when validating REAL GeoChat (do not commit backend/.env).
#
# Prerequisites:
# 1. Colab/Kaggle GPU service running (see services/geochat/DEVELOPER.md)
# 2. ngrok/localtunnel exposing port 8000 (Colab) or 8080 (bare GPU host)
# 3. GET <tunnel>/health returns model_loaded=true

GEOCHAT_VQA_PROVIDER=geochat_service
GEOCHAT_SERVICE_URL=https://YOUR-TUNNEL-HOST
GEOCHAT_MODEL_ID=MBZUAI/geochat-7B
GEOCHAT_SERVICE_TIMEOUT_S=120

# Optional: enable opt-in real GPU pytest
# GEOCHAT_REAL_SERVICE_TEST=true
